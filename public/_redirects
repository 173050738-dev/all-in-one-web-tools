# 注意：HTTPS 强制跳转请到 Cloudflare 后台 SSL/TLS → Edge Certificates → 开启 "Always Use HTTPS"

# ---------- 3 个历史死链修复（compare/compare/* / go/go/*），避免用户收藏的旧 URL 出现 404 ----------
#    /<lang>/compare/     → /<lang>/tools/           (对比页下线，统一跳工具列表)
#    /<lang>/compare/<slug> → /<lang>/tool/<slug>    (单工具对比 → 工具详情)
#    /<lang>/go/          → /<lang>/tools/           (跳转中心下线)
#    /<lang>/go/<slug>    → /<lang>/tool/<slug>      (旧外链 → 对应工具详情)
/zh/compare    /zh/tools/          301
/zh/compare/   /zh/tools/          301
/zh/compare/*  /zh/tool/:splat     301
/zh/go         /zh/tools/          301
/zh/go/        /zh/tools/          301
/zh/go/*       /zh/tool/:splat     301

