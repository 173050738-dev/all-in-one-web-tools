# ============================================================
# Cloudflare Pages 自动应用的安全响应头配置文件
# 部署到 Cloudflare Pages 时会自动读取 public/_headers 并应用
# 格式参考：https://developers.cloudflare.com/pages/configuration/headers/
# ============================================================

# ---------- 全站所有路径（最高优先级应用：严格的安全响应头
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), accelerometer=(), gyroscope=(), magnetometer=(), usb=()
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1
  Content-Security-Policy: default-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https: http: https://www.google-analytics.com https://stats.g.doubleclick.net https://static.cloudflareinsights.com; font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://region2.google-analytics.com https://*.analytics.google.com https://static.cloudflareinsights.com https://cloudflareinsights.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://tagmanager.google.com https://static.cloudflareinsights.com; upgrade-insecure-requests

# ============================================================
# 性能加速 & 长缓存（配合 Brotli + splitChunks 后产物）
# 后声明的 /_next/static/ 等更具体路径优先级更高
# ============================================================

# ---------- Next.js 静态 chunk（hash 文件名，可永久缓存）
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding
  # ASSETS-CACHE-TAG-PLACEHOLDER

# ---------- 语言包 locale json（内容稳定，1 个月缓存 + SWR 兜底）
/locales/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400, stale-if-error=604800
  Vary: Accept-Encoding
  Cache-Tag: korelyy-assets

# ---------- 公共静态资源（svg/ico/图片/manifest）
/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Vary: Accept-Encoding
/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Vary: Accept-Encoding
/*.webmanifest
  Cache-Control: public, max-age=604800
/*.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/*.txt
  Cache-Control: public, max-age=3600

# ---------- HTML 页面：短缓存 + stale-while-revalidate
# 保证搜索引擎 & 用户首屏拿到最新内容，同时 Cloudflare 边缘节点命中高
# Cache-Tag 由 deploy workflow 按 MODE 动态注入（legacy=korelyy-legacy-<runid> / isr=korelyy-isr-<runid>）
# 清缓存时 Cloudflare → Caching → Purge → Purge by Cache-Tag 精准清，无需 Purge Everything
/*.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400, stale-if-error=604800
  Vary: Accept-Encoding, Accept-Language
  # CACHE-TAG-PLACEHOLDER-DO-NOT-REMOVE
