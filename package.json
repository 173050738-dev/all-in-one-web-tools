{
  "name": "tool-station",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-data-bundles.cjs ; node scripts/generate-blog-routes.cjs ; node scripts/build-sitemap-robots.mjs",
    "build": "next build",
    "build:legacy": "set USE_STATIC_EXPORT=true&& next build",
    "build:cf": "node scripts/run-next-on-pages.cjs",
    "postbuild": "node scripts/rewrite-meta.cjs && node scripts/post-build.cjs",
    "wrangler:patch": "node scripts/patch-wrangler.cjs",
    "_skip_predeploy": "npm run build",
    "deploy": "pnpm run build:cf && pnpm run wrangler:patch && wrangler pages deploy .vercel/output/static --branch main --commit-dirty=true --project-name korelyy-tools",
    "deploy:legacy": "pnpm run build:legacy && pnpm run wrangler:patch && wrangler pages deploy ./out --branch main --commit-dirty=true --project-name korelyy-tools",
    "deploy:auth": "wrangler deploy -c workers/auth/wrangler.auth.jsonc",
    "start": "next start",
    "lint": "next lint",
    "clean": "node scripts/clean.cjs",
    "clean:cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup.ps1",
    "clean:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup.ps1 -Full",
    "clean:purge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup.ps1 -Full -PurgeDeps",
    "clean:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/cleanup.ps1 -WhatIf"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.1",
    "critters": "^0.0.25",
    "i18next": "^23.11.0",
    "lucide-react": "^0.368.0",
    "next": "^15.0.0",
    "next-intl": "^3.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "wrangler": "^4.103.0"
  }
}